# Optional. Chrono remains fully testable in deterministic demo mode without any key.
# Keep real keys only in the gitignored .env.local file.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional alternative. Set AI_PROVIDER=openai to use these values instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
